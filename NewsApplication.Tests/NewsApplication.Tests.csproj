<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Committed pipeline payloads, read at runtime by the DTO contract tests. -->
  <ItemGroup>
    <Content Include="Samples\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NewsApplication.Domain\NewsApplication.Domain.csproj" />
    <ProjectReference Include="..\NewsApplication.Repository\NewsApplication.Repository.csproj" />
    <ProjectReference Include="..\NewsApplication.Service\NewsApplication.Service.csproj" />
    <ProjectReference Include="..\NewsApplication.Web\NewsApplication.Web.csproj" />
  </ItemGroup>

</Project>
