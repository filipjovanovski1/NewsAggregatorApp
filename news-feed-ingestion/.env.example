BACKEND_BASE_URL=http://localhost:8082
BACKEND_INGESTION_TOKEN=replace-me
# WORKER_ID defaults to the machine/container hostname.
CLAIM_BATCH_SIZE=5
LEASE_SECONDS=300
POLL_INTERVAL_SECONDS=10
MAX_CONCURRENT_FEEDS=5
MAX_CONCURRENT_ARTICLES=20
MAX_REQUESTS_PER_HOST=2
FEED_TIMEOUT_SECONDS=15
ARTICLE_TIMEOUT_SECONDS=20
FEED_MAX_BYTES=2097152
ARTICLE_MAX_BYTES=5242880
MAX_ARTICLES_PER_FEED=50
MAX_REDIRECTS=5
TRAFILATURA_FAVOR_PRECISION=true
LOG_LEVEL=INFO
