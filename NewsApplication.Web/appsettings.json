{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "https://mynewsaggregatorapp.netlify.app"
    ]
  },
  "ConnectionStrings": {
    "Default": ""
  },

  "DiscoveryPipeline": {
    "BaseUrl": "http://localhost:8000",
    "CallbackBaseUrl": "http://localhost:8080",
    "SharedSecret": ""
  },

  "DiscoveryScheduler": {
    "Enabled": false,
    "DispatchBatchSize": 1,
    "FeedBatchSize": 500,
    "PollBatchSize": 100
  },

  "FeedIngestion": {
    "ExternalWorkerEnabled": false,
    "Token": ""
  },

  "Agent": {
    "Token": ""
  },

  "Dev": {
    "Enabled": false
  }
}
