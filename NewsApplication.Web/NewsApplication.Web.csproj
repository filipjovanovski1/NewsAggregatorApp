<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	  <UserSecretsId>3eac51ca-6217-4230-b405-ff564fa8d451</UserSecretsId>
  </PropertyGroup>

	<ItemGroup>
		<Compile Remove="ClientApp\Dockerfile" />
		<Compile Remove="ClientApp\nginx.conf" />
		<Compile Remove="Dockerfile" />
	</ItemGroup>

	<!-- Link the CSVs from the Repository project and copy them to output -->
	<ItemGroup>
		<Content Include="..\NewsApplication.Repository\Data\List_of_countries_with_ISO3.csv" Link="Data\List_of_countries_with_ISO3.csv">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="..\NewsApplication.Repository\Data\List_of_cities.csv" Link="Data\List_of_cities.csv">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<!-- Packages -->
	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.3" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.10" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.10">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.10" />
		<PackageReference Include="Microsoft.TypeScript.MSBuild" Version="5.9.2">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
		<PackageReference Include="Scrutor" Version="6.1.0" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.6" />
	</ItemGroup>

	<!-- Project references -->
	<ItemGroup>
		<ProjectReference Include="..\NewsApplication.Domain\NewsApplication.Domain.csproj" />
		<ProjectReference Include="..\NewsApplication.Repository\NewsApplication.Repository.csproj" />
		<ProjectReference Include="..\NewsApplication.Service\NewsApplication.Service.csproj" />
	</ItemGroup>

	<!-- Let MSBuild treat vite.config.ts as TS (optional for your workflow) -->
	<ItemGroup>
		<TypeScriptCompile Include="ClientApp\vite.config.ts" />
	</ItemGroup>

	<ItemGroup>
		<None Include="ClientApp\Dockerfile" />
		<None Include="ClientApp\nginx.conf" />
		<None Include="Dockerfile" />
	</ItemGroup>

	<ItemGroup>
		<None Update="Scripts\Ollama\*.ps1">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
